// Sample illustrating base array use.

// Fixed size literal init
fixed int a[3] = {10, 20, 30};

// Fixed size literal init (partial)
b := fixed int[300]{1, 2};

// Dynamic size literal init
c := int[5]{1, 2, 3, 4, 5};

// Dynamic size literal init (partial)
d := int[50]{1, 2, 3, 4, 5};

// Dynamic size literal init (partial), alternate syntax
e := [50 int]{1, 2, 3, 4, 5};

// Fixed size no  init
f := fixed int[300];

// Dynamic size no init
g := int[5];

// Dynamic size no init, alternate syntax
h := [10 int];

printf("e[0]=%d; d[0]=%d\n", e[0], d[0]);
printf("e[30]=%d (should be 0); d[30]=%d (should be 0)\n", e[30], d[30]);

// Size of fixed-sized array
printf("f.size()=%d\n", f.size());

// Size of dynamically-sized array
printf("e.size()=%d\n", e.size());

e.resize(200);

printf("e.size()=%d\n", e.size());
