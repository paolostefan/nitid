package gfx;

link_lib "m";
link_lib "SDL3";

extern "C" fn SDL_GetError() -> u8 *;
extern "C" fn SDL_CreateWindowAndRenderer(u8 *title, int w, int h, u64 flags, void *window_ptr, void *renderer_ptr) -> bool;
extern "C" fn SDL_CreateTexture(void *renderer, u32 fmt, int access, int w, int h) -> void *;
extern "C" fn SDL_DestroyWindow(void *win);
extern "C" fn SDL_UpdateTexture(void *texture, void *rect, void *pixels, int pitch);
extern "C" fn SDL_RenderTexture(void *renderer, void *texture, void *srcrect, void *dstrect) -> bool;
extern "C" fn SDL_RenderPresent(void *renderer);

struct Canvas {
  window: void *; // SDL_Window
  renderer: void *; // SDL_Renderer
  texture: void *; // SDL_Texture
  framebuffer: u32 *;
  width: u16;
  height: u16;
};

impl Canvas {
  fn init(u16 width, u16 height) -> bool {
    if (!SDL_CreateWindowAndRenderer("Canvas", width, height, 0,
        &self.window, &self.renderer)) {
      printf("Failed to create window and/or renderer: %s\n", SDL_GetError());
      return false;
    }

    self.framebuffer = malloc(width * height * 4);
    if (self.framebuffer == nil) {
      printf("Failed to allocate framebuffer\n");
      return false;
    }

    self.width = width;
    self.height = height;
    self.texture = SDL_CreateTexture(self.renderer,
                                     0x16362004, // SDL_PIXELFORMAT_ARGB8888
                                     2, // SDL_TEXTUREACCESS_TARGET
                                     width, height); // SDL_PIXELFORMAT_RGBA8888
    if (self.texture == nil) {
      printf("Failed to create texture: %s\n", SDL_GetError());
      return false;
    }
    return true;
  }

  fn clear() {
    if (self.framebuffer != nil) {
      memset(self.framebuffer, 0, self.width * self.height * 4);
    }
  }

  fn set_pixel(int x, int y, u32 color) {
    if (x < 0 || x >= self.width || y < 0 || y >= self.height) {
      return;
    }
    unsafe {
      *(self.framebuffer + y * self.width + x) = color;
    }
  }

  fn present() {
    SDL_UpdateTexture(self.texture, nil, self.framebuffer, self.width * 4);
    SDL_RenderTexture(self.renderer, self.texture, nil, nil);
    SDL_RenderPresent(self.renderer);
  }
}