fn main {
    // ── String concatenation ──────────────────────────────────
    string s1 = "Hello";
    string s2 = " World";
    string result = s1 + s2;
    println(result);
  
    // ── String comparison ─────────────────────────────────────
    string a = "alpha";
    string b = "beta";
    
    if (a == a) {
        println("eq works");
    }
    if (a != b) {
        println("ne works");
    }
    if (a < b) {
        println("lt works");
    }
    if (b > a) {
        println("gt works");
    }
    if (a <= a) {
        println("le works");
    }
    if (b >= a) {
        println("ge works");
    }
  
    // ── String indexing (codepoint) ───────────────────────────
    string greet = "Hi 🌍";
    u32 cp0 = greet[0];
    u32 cp1 = greet[1];
  
    // ── string16 operations ───────────────────────────────────
    string16 s16a = "Hello";
    string16 s16b = " World";
    string16 r16 = s16a + s16b;
    println(r16);
  
    if (s16a == s16a) {
        println("s16 eq works");
    }
    if (s16a != s16b) {
        println("s16 ne works");
    }
    u32 cp16 = s16a[0];
  
    // ── string32 operations ───────────────────────────────────
    string32 s32a = "Hello";
    string32 s32b = " World";
    string32 r32 = s32a + s32b;
    println(r32);
  
    if (s32a == s32a) {
        println("s32 eq works");
    }
    if (s32a != s32b) {
        println("s32 ne works");
    }
    u32 cp32 = s32a[0];
}
