// Demonstrate typed arrays with various scalar types

fixed f64 a[3] = {1.5, 2.5, 3.5};
printf("f64[0]=%f f64[1]=%f f64[2]=%f\n", a[0], a[1], a[2]);

fixed bool b[3] = {true, false, true};
printf("bool[0]=%d bool[1]=%d bool[2]=%d\n", b[0], b[1], b[2]);

fixed u8 c[2] = {100, 200};
printf("u8[0]=%d u8[1]=%d\n", c[0], c[1]);

fixed i64 d[2] = {1000000000000, 2000000000000};
printf("i64[0]=%ld i64[1]=%ld\n", d[0], d[1]);
