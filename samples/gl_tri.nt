link_lib "m";
link_lib "SDL3";

// Misc functions
extern "C" fn sin(f64 x) -> f64;
extern "C" fn cos(f64 x) -> f64;
extern "C" fn sqrt(f64 x) -> f64;
extern "C" fn malloc(u64 size) -> void *;
extern "C" fn free(void *p);

// SDL3 structs
struct SDL_Event {
    type_field: u32;
    reserved: u32;
    timestamp: u64;
    padding: fixed u8[112];  // SDL_Event is a 128-byte union
}

// SDL3 functions
extern "C" fn SDL_Init(u32 flags) -> bool;
extern "C" fn SDL_Quit();
extern "C" fn SDL_GetError() -> u8 *;
extern "C" fn SDL_CreateWindow(u8 *title, int w, int h, u64 flags) -> void *;
extern "C" fn SDL_DestroyWindow(void *win);
extern "C" fn SDL_PollEvent(SDL_Event *event) -> bool;
extern "C" fn SDL_Delay(u32 ms);
extern "C" fn SDL_RenderPresent(void *renderer);
extern "C" fn SDL_RenderClear(void *renderer);
extern "C" fn SDL_GetTicks() -> u64;
extern "C" fn SDL_GL_SwapWindow(void *win) -> bool;

extern "C" fn SDL_GL_CreateContext(void *win) -> void *;
extern "C" fn SDL_GL_DestroyContext(void *ctx) -> bool;
extern "C" fn nitid_glad_load() -> int;

extern "C" fn nitid_shader_source(u32 shader, u8 *src);
extern "C" fn glCreateShader(u32 shader_type) -> u32;
extern "C" fn glCompileShader(u32 shader);
extern "C" fn glCreateProgram() -> u32;
extern "C" fn glGenBuffers(u32 n, u32 *buffers);
extern "C" fn glBindBuffer(u32 target, u32 buffer);
extern "C" fn glBufferData(u32 target, u64 size, void *data, u32 usage);
extern "C" fn nitid_vertex_attrib_offset(u32 index, i32 size, u32 typ, u8 normalized, int stride, i64 offset);
extern "C" fn glClearColor(f32 r, f32 g, f32 b, f32 a);
extern "C" fn glClear(u32 mask);
extern "C" fn glDrawArrays(u32 mode, i32 first, i32 count);

extern "C" fn glGetShaderiv(u32 shader, u32 pname, i32 *params);
extern "C" fn glAttachShader(u32 program, u32 shader);
extern "C" fn glBindAttribLocation(u32 program, u32 index, u8 *name);
extern "C" fn glLinkProgram(u32 program);
extern "C" fn glGetProgramiv(u32 program, u32 pname, i32 *params);
extern "C" fn glUseProgram(u32 program);
extern "C" fn glGetUniformLocation(u32 program, u8 *name) -> int;
extern "C" fn glUniform1f(int location, f32 value);
extern "C" fn glEnableVertexAttribArray(u32 index);
extern "C" fn glDeleteShader(u32 shader);
extern "C" fn glDeleteProgram(u32 program);

type GlGetShaderivFn = fn (u32, u32, i32 *) -> void;
type GlGetShaderInfoLogFn = fn (u32, int, i32 *, u8 *) -> void;
type GlGetProgramivFn = fn (u32, u32, i32 *) -> void;
type GlGetProgramInfoLogFn = fn (u32, int, i32 *, u8 *) -> void;
type GlDeleteShaderFn = fn (u32) -> void;
type GlGetUniformLocationFn = fn (u32, u8 *) -> int;
type GlUniform1fFn = fn (int, f32) -> void;
type GlGenBuffersFn = fn (int, u32 *) -> void;
type GlBindBufferFn = fn (u32, u32) -> void;
type GlBufferDataFn = fn (u32, u64, void *, u32) -> void;
type GlGenVertexArraysFn = fn (int, u32 *) -> void;
type GlBindVertexArrayFn = fn (u32) -> void;
type GlEnableVertexAttribArrayFn = fn (u32) -> void;
type GlVertexAttribPointerFn = fn (u32, int, u32, u8, int, void *) -> void;
type GlCreateShaderFn = fn (u32) -> u32;
type GlShaderSourceFn = fn (u32, int, u8 *, i32 *) -> void;
type GlCompileShaderFn = fn (u32) -> void;
type GlCreateProgramFn = fn () -> u32;
type GlAttachShaderFn = fn (u32, u32) -> void;
type GlLinkProgramFn = fn (u32) -> void;
type GlUseProgramFn = fn (u32) -> void;
type GlDrawArraysFn = fn (u32, int, int) -> void;

// GL entry points arrive as parameters — a Nitid function pointer type is
// only ever usable as a parameter or field type.
fn shader_types_check(GlGetShaderivFn gl_get_shaderiv, u32 shader) -> i32 {
    i32 success = 0;
    gl_get_shaderiv(shader, 0x8B81, &success);   // GL_COMPILE_STATUS
    return success;
}

fn program_types_check(GlGetProgramivFn gl_get_programiv, u32 program) -> i32 {
    i32 success = 0;
    gl_get_programiv(program, 0x8B82, &success); // GL_LINK_STATUS
    return success;
}

fn set_time_uniform(GlGetUniformLocationFn gl_get_uniform_location,
                    GlUniform1fFn gl_uniform_1f,
                    u32 program,
                    u64 time_ms) {
  i32 loc = gl_get_uniform_location(program, "uTime");
  f64 secs = time_ms;
  secs = secs * 0.001;          // widen first: u64 * f64 is a type mismatch
  gl_uniform_1f(loc, secs);
}

fn make_shader(u32 shader_type, u8 *src) -> u32 {
  u32 shader = glCreateShader(shader_type);
  nitid_shader_source(shader, src);
  glCompileShader(shader);

  i32 ok = 0;
  glGetShaderiv(shader, 0x8B81, &ok);   // GL_COMPILE_STATUS
  if (ok == 0) {
    println("Shader compilation failed");
    return 0;
  }
  return shader;
}


fn main() -> int {

  if (!SDL_Init(0x20)) {  // SDL_INIT_VIDEO
    printf("SDL_Init failed\n");
    return 1;
  }

  int width = 800;
  int height = 600;

  void *win = SDL_CreateWindow("Nitid GL triangle", width, height, 0x00000002); // SDL_WINDOW_OPENGL
  if(!win) {
    printf("Window creation failed: %s\n", SDL_GetError());
    SDL_Quit();
    return 1;
  }

  void *ctx = SDL_GL_CreateContext(win);
  if (!ctx) {
    printf("OpenGL context creation failed: %s\n", SDL_GetError());
    SDL_DestroyWindow(win);
    SDL_Quit();
    return 1;
  }

  if (nitid_glad_load() == 0) {
    printf("Failed to load OpenGL functions\n");
    SDL_GL_DestroyContext(ctx);
    SDL_DestroyWindow(win);
    SDL_Quit();
    return 1;
  }

  SDL_Event event = SDL_Event{ type_field: 0, reserved: 0, timestamp: 0, padding: {0} };

  // Vertex shader — unchanged
  u8 *vs_source = "#version 120\nattribute vec2 pos;\nattribute vec3 col;\nvarying vec3 vCol;\nvoid main() {\n  gl_Position = vec4(pos, 0.0, 1.0);\n  vCol = col;\n}\n";
  u32 vertex_shader = make_shader(0x8B31, vs_source);  // GL_VERTEX_SHADER

  // Fragment shader — animate color with time
  u8 *fs_source = "#version 120\nuniform float uTime;\nvarying vec3 vCol;\nvoid main() {\n  float t = uTime * 0.001;\n  vec3 anim = vCol * (0.5 + 0.5 * sin(t + vCol));\n  gl_FragColor = vec4(anim, 1.0);\n}\n";

  u32 fragment_shader = make_shader(0x8B30, fs_source); // GL_FRAGMENT_SHADER
  u32 program = glCreateProgram();
  glAttachShader(program, vertex_shader);
  glAttachShader(program, fragment_shader);
  glBindAttribLocation(program, 0, "pos");
  glBindAttribLocation(program, 1, "col");
  glLinkProgram(program);

  i32 linked = 0;
  glGetProgramiv(program, 0x8B82, &linked); // GL_LINK_STATUS
  if (linked == 0) {
    println("Program linking failed");
    return 1;
  }

  glDeleteShader(vertex_shader);
  glDeleteShader(fragment_shader);

  glUseProgram(program);

    // Vertex data: x, y, r, g, b for each vertex
  vertices := fixed f32[15]{
      -0.5, -0.5,  1.0, 0.0, 0.0,   // bottom-left, red
      0.5, -0.5,  0.0, 1.0, 0.0,   // bottom-right, green
      0.0,  0.5,  0.0, 0.0, 1.0    // top, blue
  };

  u32 vbo = 0;
  glGenBuffers(1, &vbo);
  glBindBuffer(0x8892, vbo); // GL_ARRAY_BUFFER
  glBufferData(0x8892, 15 * 4, &vertices, 0x88E4); // GL_STATIC_DRAW

  glEnableVertexAttribArray(0); // pos
  nitid_vertex_attrib_offset(0, 2, 0x1406, 0, 5 * 4, 0);   // GL_FLOAT, stride=5*4, offset 0
  glEnableVertexAttribArray(1); // col
  nitid_vertex_attrib_offset(1, 3, 0x1406, 0, 5 * 4, 8);   // GL_FLOAT, stride=5*4, offset 2*4

  int u_time = glGetUniformLocation(program, "uTime");

  running := true;
  while (running) {
    SDL_Delay(16);  // ~60fps
    
    u64 now = SDL_GetTicks();
    f64 time_secs = now;

    glUniform1f(u_time, time_secs);

    glClearColor(0.1, 0.1, 0.15, 1.0);
    glClear(0x00004000); // GL_COLOR_BUFFER_BIT
    glDrawArrays(0x0004, 0, 3); // GL_TRIANGLES, first=0, count=3
    SDL_GL_SwapWindow(win);
    
    while (SDL_PollEvent(&event)) {
      if (event.type_field == 0x100) {  // SDL_QUIT
        running = false;
      }
    }
  }

  glDeleteProgram(program);
  SDL_GL_DestroyContext(ctx);
  SDL_DestroyWindow(win);
  SDL_Quit();

  return 0;
}

